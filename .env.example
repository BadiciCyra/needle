# --- LLM (OpenAI uyumlu uç nokta) ---
# Varsayılan: Gemini'nin OpenAI uyumlu uç noktası. Anahtar: https://aistudio.google.com/apikey
# Diğer seçenekler (kod değişmez, sadece bu üç satır):
#   Ollama (tamamen yerel):              http://127.0.0.1:11434/v1        (anahtar gerekmez)
#   OmniRoute (çoklu sağlayıcı geçidi):  http://127.0.0.1:20128/v1        (docker compose --profile omniroute)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Demo için TEK bir modele sabitle
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# --- Demo modu ---
# off: her zaman LLM | record: LLM + önbelleğe kaydet | replay: sadece önbellek (internet yoksa)
DEMO_MODE=off

# --- Veritabanı (docker dışından çalıştırırken) ---
DATABASE_URL=postgresql+psycopg://needle:needle@127.0.0.1:5432/needle

# --- Seed ---
# startups_gercek.json: gerçek girişimler (kaynaklı) | startups.json: kurgusal 40 girişim (testler bunu kullanır)
STARTUPS_FILE=startups_gercek.json

# --- Reranker ---
# llm: LLM ile sırala (önerilen; Türkçe ihtiyaçlarda en isabetlisi) | cross_encoder: yerel çok dilli model | none: sadece vektör skoru
RERANK_BACKEND=llm

# --- Hesaplar ---
# HTTPS arkasında yayına alınınca true (çerez yalnızca HTTPS ile gönderilir)
COOKIE_SECURE=false

# --- E-posta (şifre sıfırlama) ---
# Boş bırakılırsa e-posta gönderilmez; sıfırlama bağlantısı API loguna yazılır (docker compose logs api)
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Needle <no-reply@needle.local>
