# --- LLM (OpenAI uyumlu uç nokta) ---
# OmniRoute (varsayılan, docker compose içinden):   http://omniroute:20128/v1
# OmniRoute (yerelde, docker dışından çalıştırırken): http://localhost:20128/v1
# Ollama (tamamen yerel, açık kaynak model):          http://localhost:11434/v1
LLM_BASE_URL=http://localhost:20128/v1
# OmniRoute için anahtar gerekmez; doğrudan bir sağlayıcıya bağlanırken buraya yazılır
LLM_API_KEY=not-needed
# OmniRoute panelinde seçtiğin modelin adı. Demo için TEK bir modele sabitle.
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# --- Demo modu ---
# off: her zaman LLM | record: LLM + önbelleğe kaydet | replay: sadece önbellek (internet yoksa)
DEMO_MODE=off

# --- Veritabanı (docker dışından çalıştırırken) ---
DATABASE_URL=postgresql+psycopg://needle:needle@localhost:5432/needle

# --- Reranker ---
# cross_encoder: yerel çok dilli model | llm: LLM ile sırala | none: sadece vektör skoru
RERANK_BACKEND=cross_encoder
